# Copy this file to .env.local and fill in the two values.
#
# In the class: your teacher gives you both values.
# Without these values the app starts in mock mode: your changes stay in your browser.

# Project URL
VITE_SUPABASE_URL=https://rgxxvnzzvlppperdbikm.supabase.co

# Publishable key ("sb_publishable_..."; older projects call it the anon key).
# It is safe for the browser. There is no login in this project, so each
# person with the key can change the board. Do not put private data on it.
VITE_SUPABASE_ANON_KEY=

# Optional, teacher only: the Google Apps Script web app for the sign-up form at /join.
# Students do not need it. Without it, the form shows but cannot send.
VITE_SIGNUP_URL=
